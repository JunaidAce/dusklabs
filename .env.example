# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Primary PostgreSQL (Production / Local Postgres)
DATABASE_URL="postgresql://dusklabs:dusklabs_dev_pw@localhost:5432/dusklabs?schema=public"

# Academic Evaluation SQLite Fallback (use with db:generate:sqlite & db:push:sqlite)
# DATABASE_URL="file:./dev.db"

# Security Secrets (replace with 32+ byte CSPRNG hex values in production)
SESSION_SECRET="replace-with-64-char-hex-secret-for-session-signing-0000000000"
FLAG_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
FLAG_HMAC_PEPPER="replace-with-64-char-hex-pepper-for-static-flag-hashing-000000"

# Attachment Vault
UPLOAD_DIR="./apps/api/storage/attachments"
MAX_ATTACHMENT_BYTES=26214400

# Attachment Rust micro-service (c23)
RUST_ATTACHMENT_URL="http://127.0.0.1:4100"
RUST_INTERNAL_TOKEN="dev-internal-token-change-me"
RUST_TIMEOUT_MS=5000
ALLOW_TS_ATTACHMENT_FALLBACK=true
