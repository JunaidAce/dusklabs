  previousStatus String
  newStatus      String
  reason         String
  actorId        String?   // Null when temporary suspension auto-expires at login
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  user  User  @relation("ModeratedUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("ModerationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Report {
  id                  String    @id @default(cuid())
  reporterId          String
  competitionId       String?
  challengeId         String?
  targetUserId        String?
  submissionId        String?
  category            String    // BUG | DISPUTE | CHEATING | ABUSE
  description         String
  isAnonymous         Boolean   @default(false)
  status              String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | DISMISSED
  assignedModeratorId String?
  internalNotes       String?
  resolution          String?
  resolvedById        String?
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  resolvedAt          DateTime?

  reporter          User         @relation("ReportAuthor", fields: [reporterId], references: [id])
  resolvedBy        User?        @relation("ReportResolver", fields: [resolvedById], references: [id])
  assignedModerator User?        @relation("ReportAssignee", fields: [assignedModeratorId], references: [id], onDelete: SetNull)
  targetUser        User?        @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  competition       Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  challenge         Challenge?   @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetUserId, status])
  @@index([assignedModeratorId, status])
}

