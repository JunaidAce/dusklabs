  updatedAt            DateTime @updatedAt

  challenge Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  unlocks   HintUnlock[]

  @@unique([challengeId, sortOrder])
}

model HintUnlock {
  id            String   @id @default(cuid())
  hintId        String
  userId        String
  teamId        String?
  competitionId String?
  costApplied   Int
  unlockedAt    DateTime @default(now())

  hint              Hint               @relation(fields: [hintId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  team              Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  competition       Competition?       @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  scoreTransactions ScoreTransaction[]

  @@unique([hintId, userId])
  @@unique([hintId, teamId])
}

model Submission {
  id            String   @id @default(cuid())
  challengeId   String
  competitionId String?
  userId        String
  teamId        String?
  submittedHash String
  isCorrect     Boolean
  ipAddress     String?
  submittedAt   DateTime @default(now())

  challenge            Challenge                     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  competition          Competition?                  @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  user                 User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  team                 Team?                         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  disputeCorrections   SubmissionDisputeCorrection[]

  @@index([challengeId, userId, submittedAt])
  @@index([competitionId, isCorrect])
}

model SubmissionDisputeCorrection {
  id                 String   @id @default(cuid())
  submissionId       String
  action             String   // CREDIT_POINTS | REVOKE_POINTS | UPHOLD_ORIGINAL
  previousState      String
  resultingState     String
  deltaPoints        Int      @default(0)
  reason             String
  scoreTransactionId String?
  adminId            String
  createdAt          DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  admin      User       @relation("DisputeAdmin", fields: [adminId], references: [id])

  @@index([submissionId, createdAt])
}

model Solve {
  id                    String   @id @default(cuid())
  challengeId           String
  competitionId         String?
  userId                String
  teamId                String?
  isFirstBlood          Boolean  @default(false)
  firstBloodChallengeId String?  @unique // Populated ONLY on the winning First Blood solve
  pointsAwarded         Int
  solvedAt              DateTime @default(now())

  challenge         Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  competition       Competition?       @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  team              Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  scoreTransactions ScoreTransaction[]

  @@unique([challengeId, userId])
  @@unique([challengeId, teamId])
  @@index([competitionId, solvedAt])
}

model ScoreTransaction {
  id             String   @id @default(cuid())
  userId         String
  teamId         String?
  competitionId  String?
  solveId        String?
  hintUnlockId   String?
  idempotencyKey String?  @unique
  deltaPoints    Int
  type           String   // SOLVE | FIRST_BLOOD | HINT_PENALTY | DYNAMIC_RECALC | MANUAL_ADJUSTMENT
  reason         String
  actorId        String?
  createdAt      DateTime @default(now())

  user        User         @relation("UserScoreTransactions", fields: [userId], references: [id], onDelete: Cascade)
  actor       User?        @relation("ActorScoreTransactions", fields: [actorId], references: [id], onDelete: SetNull)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  competition Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  solve       Solve?       @relation(fields: [solveId], references: [id], onDelete: SetNull)
  hintUnlock  HintUnlock?  @relation(fields: [hintUnlockId], references: [id], onDelete: SetNull)

  @@index([competitionId, userId])
  @@index([competitionId, teamId])
  @@index([createdAt])
}

model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  ruleType    String   // FIRST_BLOOD | TOTAL_SOLVES | CATEGORY_SOLVES:<slug> | COMPETITION_PARTICIPATION | COMPETITION_CHAMPION
  threshold   Int      @default(1)
  tier        String   @default("BRONZE") // BRONZE | SILVER | GOLD | APEX
  iconKey     String   @default("HEX_CORE")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  awards UserAchievement[]
}

model UserAchievement {
  id                 String   @id @default(cuid())
  userId             String
  achievementId      String
  competitionId      String?
  teamId             String?
  challengeId        String?
  awardScopeKey      String   @default("GLOBAL") // "GLOBAL" or competitionId
  awardedName        String
  awardedDescription String
  awardedTier        String   @default("BRONZE")
  awardedIcon        String   @default("HEX_CORE")
  awardedAt          DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement  @relation(fields: [achievementId], references: [id], onDelete: Restrict)
  competition Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)

  @@unique([userId, achievementId, awardScopeKey])
  @@index([userId, awardedAt])
}

model Announcement {
  id            String   @id @default(cuid())
  competitionId String?  // Null = platform-wide announcement
  authorId      String
  title         String
  body          String
  isPinned      Boolean  @default(false)
  publishedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])

  @@index([competitionId, publishedAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    // COMP_REG | COMP_LIVE | COMP_END | TEAM_INVITE | TEAM_UPDATE | SOLVE | ANNOUNCEMENT | ACHIEVEMENT
  title     String
  message   String
  linkUrl   String?
  dedupeKey String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt])
}

model ContactInquiry {
  id           String    @id @default(cuid())
  userId       String?
  name         String
  email        String
  category     String    // GENERAL | COMPETITION | SECURITY_DISCLOSURE | ACCOUNT_SUPPORT | PARTNERSHIP
