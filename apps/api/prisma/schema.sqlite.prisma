  ipHash       String?
  adminNotes   String?
  reviewedById String?
  assignedAdminId String?
  version      Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  resolvedAt   DateTime?

  user       User? @relation("ContactSubmitter", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("ContactReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  assignedAdmin User? @relation("ContactAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

